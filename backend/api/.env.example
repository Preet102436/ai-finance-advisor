# Copy this file to `.env` (in this same directory) and fill in real values.
# .env is gitignored and should never be committed.

# --- PostgreSQL connection (local, non-Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_advisor
DB_USER=postgres
DB_PASSWORD=changeme

# --- JWT auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Receipt OCR ---
# Only needed if `tesseract` isn't on your system PATH (common on Windows).
# Point this at the installed binary instead of editing PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- OpenAI (chat + receipt category/total extraction) ---
# Optional in both places - without it, chat falls back to a plain-language
# message built from retrieved transactions, and receipt upload falls back
# to the keyword/regex heuristics in ocr_prototype.py.
# OPENAI_API_KEY=sk-...
