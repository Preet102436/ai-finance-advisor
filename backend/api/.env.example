# Copy this file to `.env` (in this same directory) and fill in real values.
# .env is gitignored and should never be committed.

# --- PostgreSQL connection (local, non-Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_advisor
DB_USER=postgres
DB_PASSWORD=changeme

# --- JWT auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Receipt OCR (optional) ---
# Only needed if `tesseract` isn't on your PATH and isn't in the default
# Windows install folder (C:\Program Files\Tesseract-OCR\tesseract.exe).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
